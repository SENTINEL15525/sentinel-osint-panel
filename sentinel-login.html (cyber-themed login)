<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SENTINEL - INTELLIGENCE OPERATIONS CENTER</title>
    <style>
        body {
            background-color: #000000;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            color: white;
        }

        .login-container {
            background-color: #1a1a2e;
            border-radius: 15px;
            padding: 40px;
            width: 400px;
            box-shadow: 0 0 20px rgba(0, 255, 136, 0.3);
            text-align: center;
        }

        .logo {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #00ffff, #8000ff);
            border-radius: 10px;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 15px rgba(0, 255, 136, 0.5);
        }

        .logo::before {
            content: "●";
            color: white;
            font-size: 30px;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
        }

        h1 {
            font-size: 32px;
            margin: 10px 0;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: white;
        }

        .subtitle {
            font-size: 12px;
            color: #00ffff;
            letter-spacing: 3px;
            margin-bottom: 30px;
            text-transform: uppercase;
        }

        .tabs {
            display: flex;
            margin-bottom: 25px;
        }

        .tab {
            flex: 1;
            padding: 12px;
            cursor: pointer;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 14px;
            letter-spacing: 1px;
        }

        .tab.active {
            background-color: #000000;
            border: 1px solid #00ffff;
            color: #00ffff;
            border-radius: 5px 5px 0 0;
        }

        .tab.inactive {
            background-color: #2d2d44;
            color: #666666;
        }

        .input-group {
            margin-bottom: 20px;
            text-align: left;
        }

        .input-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: #aaa;
        }

        .input-field {
            width: 100%;
            padding: 15px;
            background-color: #2d2d44;
            border: 1px solid #444;
            border-radius: 8px;
            color: white;
            font-size: 16px;
            outline: none;
            transition: border-color 0.3s;
        }

        .input-field:focus {
            border-color: #00ffff;
            box-shadow: 0 0 10px rgba(0, 255, 136, 0.3);
        }

        .login-button {
            width: 100%;
            padding: 15px;
            background: linear-gradient(90deg, #00ffff, #8000ff);
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-top: 10px;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 0 15px rgba(0, 255, 136, 0.5);
        }

        .login-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 20px rgba(0, 255, 136, 0.7);
        }

        .login-button:active {
            transform: translateY(0);
        }

        .glow {
            animation: glow 2s infinite alternate;
        }

        @keyframes glow {
            from {
                box-shadow: 0 0 5px rgba(0, 255, 136, 0.5);
            }
            to {
                box-shadow: 0 0 20px rgba(0, 255, 136, 0.8), 0 0 30px rgba(128, 0, 255, 0.6);
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="logo"></div>
        <h1>SENTINEL</h1>
        <div class="subtitle">INTELLIGENCE OPERATIONS CENTER</div>

        <div class="tabs">
            <div class="tab active">LOGIN</div>
            <div class="tab inactive">REGISTER</div>
        </div>

        <div class="input-group">
            <input type="text" class="input-field" placeholder="Username">
        </div>

        <div class="input-group">
            <input type="password" class="input-field" placeholder="Password">
        </div>

        <button class="login-button glow">LOGIN</button>
    </div>
</body>
</html>

